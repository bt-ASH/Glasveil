# Glasveil Git Ignore Rules

# Python cache & bytecode
__pycache__/
*.py[cod]

# 备份 / 临时文件
*.bak
*.bak-*
*.tmp
*~

# 运行时状态（不入库）
configs/fish/fish_variables
configs/niri/colors.kdl
configs/kitty/themes/noctalia.conf
configs/kitty/themes/noctalia-override.conf
configs/eww/color.scss
configs/matugen/state/
*.log

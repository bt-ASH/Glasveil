#!/usr/bin/env bash
# ── 电源菜单 / power menu ────────────────────────────────────────────────────
# niri 键位：Mod+X（configs/niri/binds.kdl）
# 主题：~/.config/rofi/powermenu.rasi（配色来自 matugen 渲染的 colors.rasi）
set -uo pipefail

CONF="${XDG_CONFIG_HOME:-$HOME/.config}"
THEME="$CONF/rofi/powermenu.rasi"

if [[ "${LANG:-}" == zh_* ]]; then
    OPT_LOCK="锁屏"
    OPT_SCREEN_OFF="关闭屏幕"
    OPT_QUIT="退出"
    OPT_SUSPEND="挂起"
    OPT_REBOOT="重启"
    OPT_POWEROFF="关机"
else
    OPT_LOCK="Lock"
    OPT_SCREEN_OFF="Screen Off"
    OPT_QUIT="Logout"
    OPT_SUSPEND="Suspend"
    OPT_REBOOT="Reboot"
    OPT_POWEROFF="Shutdown"
fi

# 图标用 bash 的 \u 转义写，文件保持纯 ASCII（Nerd Font 私有区）
ICON_LOCK=$'\uf023'
ICON_SCREEN_OFF=$'\uf070'
ICON_QUIT=$'\uf08b'
ICON_SUSPEND=$'\uf186'
ICON_REBOOT=$'\uf01e'
ICON_POWEROFF=$'\uf011'

# 两行四列（6 个条目占前 4 + 后 2 格），顺序与 powermenu.rasi 的 grid 一致
OPTIONS=(
    "$ICON_LOCK  $OPT_LOCK"
    "$ICON_SCREEN_OFF  $OPT_SCREEN_OFF"
    "$ICON_QUIT  $OPT_QUIT"
    "$ICON_SUSPEND  $OPT_SUSPEND"
    "$ICON_REBOOT  $OPT_REBOOT"
    "$ICON_POWEROFF  $OPT_POWEROFF"
)

if ! command -v rofi >/dev/null 2>&1; then
    notify-send "电源菜单" "缺少 rofi" 2>/dev/null || echo "powermenu: rofi not found" >&2
    exit 1
fi

# -format i 只回行号，界面里看不到内部索引
idx="$(printf '%s\n' "${OPTIONS[@]}" |
    rofi -dmenu -i -no-custom -p "" -format i -theme "$THEME" 2>/dev/null)"

[ -n "${idx:-}" ] || exit 0

lock() { hyprlock -c "$CONF/niri/hyprlock.conf" 2>/dev/null || swaylock; }

# 索引顺序：0 锁屏 / 1 关屏 / 2 退出 / 3 挂起 / 4 重启 / 5 关机
case "$idx" in
    0)
        lock
        ;;
    1)
        niri msg action power-off-monitors
        ;;
    2)
        niri msg action quit
        ;;
    3)
        lock &
        sleep 0.4
        niri msg action power-off-monitors
        systemctl suspend
        ;;
    4)
        systemctl reboot
        ;;
    5)
        systemctl poweroff
        ;;
    *)
        exit 0
        ;;
esac

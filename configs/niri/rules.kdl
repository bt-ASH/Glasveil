// =============================================================================
// Niri 窗口 / 图层规则 (rules.kdl)
// 由原 rule.kdl + blur.kdl 中通用规则整理而来，规则内容保持不变。
// overview / cursor / recent-windows 已按 Nyxuri 结构移入 config.kdl；
// gestures 已移入 input__custom__.kdl；
// 透明度 / 背景模糊等外观规则已移入 effects_normal.kdl（随护眼模式切换）。
// =============================================================================

// =============================================================================
// 图层规则
// 壁纸图层放进 backdrop —— Mod+Tab 概览里只有「一层背景」（Nyxuri 同款做法）
// =============================================================================

layer-rule {
    match namespace="^awww-daemon$"
    place-within-backdrop true
}

// 视频壁纸（如使用 mpvpaper）同理
layer-rule {
    match namespace="^mpvpaper$"
    place-within-backdrop true
}

window-rule {
    match is-floating=true
    baba-is-float false
}
            window-rule {
                // This regular expression is intentionally made as specific as possible,
                // since this is the default config, and we want no false positives.
                // You can get away with just app-id="wezterm" if you want.
                match app-id=r#"^org\.wezfurlong\.wezterm$"#
                open-floating true
                default-column-width {}
            }
            window-rule{
                    match app-id="baidunetdisk"
                    default-floating-position x=20 y=20 relative-to="top-right"
}
            window-rule{
                match app-id="clipse-gui"
                match app-id="bluetui"
                match app-id="nmtui"
                open-floating true
                default-column-width { proportion 0.4; }
                default-window-height { proportion 0.6; }
}

window-rule {
    match app-id="Conky"
    open-floating true
    open-focused false
    focus-ring{
        off
    }
    border {
        off
    }
    shadow {
        off
    }
}
window-rule {
    // This app-id regular expression will work for both:
    // - host Firefox (app-id is "firefox")
    // - Flatpak Firefox (app-id is "org.mozilla.firefox")
    //match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    match app-id="navicat"
    open-floating true
}

// Prevent --kiosk mode opening in fullscreen, requires full-screen-api.ignore-widgets=true in about:config 
window-rule {
    match app-id="org.mozilla.firefox"
    match app-id="firefox"
    open-fullscreen false
}

window-rule {
    match app-id="waypaper"
    default-column-width { proportion 0.6; }
}

window-rule {
    match app-id="pot"
    open-floating true
    default-column-width { proportion 0.2; }
    default-window-height { proportion 0.5; }
}

window-rule{
    match app-id="wiremix"
    open-floating true
    default-column-width { proportion 0.5; }
    default-window-height { proportion 0.4; }
}

window-rule {
    match app-id="QQ"
    match app-id="wechat"
    match app-id="antsword"
    open-floating true
}
window-rule {
    match app-id="mpv"
    open-floating true
    default-column-width { proportion 0.9; }
    default-window-height { proportion 0.9; }
}

window-rule {
    match app-id="scrcpy"
    open-floating false
    default-column-width { proportion 0.3; }
}

// Example: block out two password managers from screen capture.
// (This example rule is commented out with a "/-" in front.)

/-window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    match app-id=r#"^org\.gnome\.World\.Secrets$"#

    block-out-from "screen-capture"

    // Use this instead if you want them visible on third-party screenshot tools.
    // block-out-from "screencast"
}

// Example: enable rounded corners for all windows.
// (This example rule is commented out with a "/-" in front.)

// =============================================================================
// 窗口几何与边框绘制（始终生效，与透明度/模糊解耦）
// 透明度已移到 effects_normal.kdl / effects_eyecare.kdl，随护眼模式切换。
// =============================================================================

// 圆角与边框绘制（原 blur.kdl 的几何设置）
window-rule {
    geometry-corner-radius 5
    clip-to-geometry true
    draw-border-with-background false
}

// Zen 浏览器
window-rule {
    match app-id="app.zen_browser.zen"
    draw-border-with-background false
}

// Nautilus 文件管理器
window-rule {
    match app-id=r"^org\.gnome\.Nautilus$"
    draw-border-with-background false
}

// 本机原有：code-oss 几何
window-rule {
    match app-id="code-oss"
    geometry-corner-radius 5
    clip-to-geometry true
    draw-border-with-background false
}

// 本机原有：游戏/播放器组几何
window-rule {
    match app-id="steam_app_default"
    match app-id="steam"
    match app-id="mpv"
    match app-id="^Minecraft"
    match app-id="steam_app_438100"
    clip-to-geometry true
    draw-border-with-background false
}

// Gaming optimization - disable blur/effects for fullscreen windows
window-rule {
    match app-id="Wuthering Waves.exe"
    match title=r#"^Wuthering|^鸣潮|^ww"#
    // 游戏全屏，隐藏所有特效
    open-fullscreen true
    // 禁用背景模糊（通过 background-effect 节点控制）
    background-effect {
        blur false
    }
    // 禁用装饰：窗口四角、圆角裁剪、边框
    geometry-corner-radius 0
    clip-to-geometry false
    focus-ring {
        off
    }
    // 优化透明度，减少合成开销
    opacity 1.0
    // 无阴影
    shadow {
        off
    }
}

// 全窗口圆角（放在最后，优先级最高）
window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

// =============================================================================
// 应用窗口浮动规则（从 Nyxuri configs/niri/rules.kdl 移植，open-floating true）
// =============================================================================

// ==========================================
// 特定应用规则
// ==========================================

window-rule {
    match app-id=r"dev.noctalia.Noctalia"
    open-floating true
}

window-rule {
    match app-id=r"^org\.gnome\.Calculator$"
    match app-id=r"^gnome-calculator$"
    match app-id=r"^galculator$"
    match app-id=r"^blueman-manager$"
    match app-id=r"^org\.gnome\.Nautilus$"
    match app-id=r"^xdg-desktop-portal-(gnome|gtk)$"
    open-floating true
}

window-rule {
    match app-id="zoom"
    open-floating true
}

window-rule {
    match app-id="wine"
    open-floating true
    default-column-width { proportion 1.0; }
    draw-border-with-background false
}

// Wine / Proton / Windows 占位与系统托盘窗口规避 (防止 explorer.exe 托盘在屏幕中央显示 160x20 / 166x52 小黑条/占位横幅)

// Wine / Proton / Windows 占位与系统托盘窗口规避 (防止 explorer.exe 托盘在屏幕中央显示 160x20 / 166x52 小黑条/占位横幅)
window-rule {
    match app-id=r"(?i)^explorer\.exe$" title=r"^$"
    match app-id=r"(?i)^explorer\.exe$" title=r"(?i)^Wine System Tray$"
    match app-id=r"(?i)^explorer\.exe$" title=r"^Wine$"
    match app-id=r"(?i)^(wineboot|services)\.exe$"
    match title=r"(?i)^Wine System Tray$"
    open-floating true
    open-focused false
    opacity 0.0
    default-floating-position x=-9999 y=-9999
    shadow { off; }
}

// 从 glassy-niri 复制的特定应用美化规则（纯 blur，无 xray）

// 视频画中画：所有画中画全工作区悬浮（Mod+拖拽可移动）
window-rule {
    match title=r"(画中画|Picture-in-Picture)"
    open-floating true
    opacity 1.0
    default-column-width
    default-window-height
    default-floating-position x=20 y=20 relative-to="bottom-right"
}

// 视频软件适配

// 图片/视频查看器（中英文标题 + app-id 双保险）
window-rule {
    match title=r"(图片查看器|Image Viewer|图片和视频|Image and Video Viewer|视频播放器|Video Player|Videos)"
    match app-id="org.gnome.Loupe"
    match app-id="org.gnome.Totem"
    match app-id="org.gnome.Photos"
    open-floating true
    opacity 1.0
}

// steam 好友列表

// QQ 群聊的聊天记录以浮动模式打开
window-rule {
    match app-id="QQ" title="群聊的聊天记录"
    open-floating true
}

// imv 轻量图片查看器

// imv 轻量图片查看器
window-rule {
    match app-id="imv"
    open-floating true
}

// Ente-Auth 适配

// Ente-Auth 适配
window-rule {
    match app-id="io.ente.auth"
    open-floating true
    default-column-width { fixed 532; }
    default-window-height { fixed 925; }
}

// Mission Center 系统监视器

// Mission Center 系统监视器
window-rule {
    match app-id="io.missioncenter.MissionCenter"
    open-floating true
    default-column-width { proportion 0.65; }
    default-window-height { proportion 0.70; }
}

// ==========================================
// Scratchpad 终端 (Super+~ toggle)
// ==========================================

// ==========================================
// Scratchpad 终端 (Super+~ toggle)
// ==========================================
window-rule {
    match app-id=r"^scratchpad$"
    open-floating true

    // ── 位置配置 ──
    // 取消注释你想要的位置，同时注释掉其他选项。
    // 如果选择正中央，请注释掉所有 default-floating-position 行。
    //
    // 上排：
    default-floating-position x=0 y=40 relative-to="top"          // ← 当前：中上方
    // default-floating-position x=40 y=40 relative-to="top-left"  // 左上方
    // default-floating-position x=40 y=40 relative-to="top-right" // 右上方
    //
    // 中排：
    // default-floating-position x=0 y=0 relative-to="left"        // 左中
    // (注释掉所有 default-floating-position 行 = 正中央)
    // default-floating-position x=0 y=0 relative-to="right"       // 右中
    //
    // 下排：
    // default-floating-position x=40 y=40 relative-to="bottom-left"   // 左下方
    // default-floating-position x=0 y=40 relative-to="bottom"         // 中下方
    // default-floating-position x=40 y=40 relative-to="bottom-right"  // 右下方

    // ── 尺寸配置 ──
    default-column-width { proportion 0.5; }
    default-window-height { proportion 0.45; }
}

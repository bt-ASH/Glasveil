layout {
    focus-ring {
        width 2
        active-color "#320b54"
        inactive-color "transparent"
        urgent-color "#ba1a1a"
    }
    shadow {
        on
        softness 28
        spread 6
        offset x=0 y=0
        draw-behind-window false
        color "#320b5495"
        inactive-color "#00000045"
    }
    tab-indicator {
        active-color "#320b54"
        inactive-color "#49256b"
        urgent-color "#ba1a1a"
    }
    insert-hint {
        color "#320b5480"
    }
}

recent-windows {
    highlight {
        active-color "#fff7fe"
        urgent-color "#ba1a1a"
    }
}

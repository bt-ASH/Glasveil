layout {
    focus-ring {
        width 2
        active-color "#272534"
        inactive-color "transparent"
        urgent-color "#ba1a1a"
    }
    shadow {
        on
        softness 28
        spread 6
        offset x=0 y=0
        draw-behind-window false
        color "#27253495"
        inactive-color "#00000045"
    }
    tab-indicator {
        active-color "#272534"
        inactive-color "#3d3b4a"
        urgent-color "#ba1a1a"
    }
    insert-hint {
        color "#27253480"
    }
}

recent-windows {
    highlight {
        active-color "#fdf8f9"
        urgent-color "#ba1a1a"
    }
}

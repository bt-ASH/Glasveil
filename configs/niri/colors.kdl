layout {
    focus-ring {
        width 2
        active-color "#3c58a5"
        inactive-color "transparent"
        urgent-color "#ba1a1a"
    }
    shadow {
        on
        softness 28
        spread 6
        offset x=0 y=0
        draw-behind-window false
        color "#3c58a595"
        inactive-color "#00000045"
    }
    tab-indicator {
        active-color "#3c58a5"
        inactive-color "#5671bf"
        urgent-color "#ba1a1a"
    }
    insert-hint {
        color "#3c58a580"
    }
}

recent-windows {
    highlight {
        active-color "#faf8ff"
        urgent-color "#ba1a1a"
    }
}

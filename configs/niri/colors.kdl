layout {
    focus-ring {
        width 2
        active-color "#406909"
        inactive-color "transparent"
        urgent-color "#ba1a1a"
    }
    shadow {
        on
        softness 28
        spread 6
        offset x=0 y=0
        draw-behind-window false
        color "#40690995"
        inactive-color "#00000045"
    }
    tab-indicator {
        active-color "#406909"
        inactive-color "#a8d970"
        urgent-color "#ba1a1a"
    }
    insert-hint {
        color "#40690980"
    }
}

recent-windows {
    highlight {
        active-color "#f9faee"
        urgent-color "#ba1a1a"
    }
}

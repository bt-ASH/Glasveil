layout {
    focus-ring {
        width 2
        active-color "#6e5b4a"
        inactive-color "transparent"
        urgent-color "#ba1a1a"
    }
    shadow {
        on
        softness 28
        spread 6
        offset x=0 y=0
        draw-behind-window false
        color "#6e5b4a95"
        inactive-color "#00000045"
    }
    tab-indicator {
        active-color "#6e5b4a"
        inactive-color "#d0b8a4"
        urgent-color "#ba1a1a"
    }
    insert-hint {
        color "#6e5b4a80"
    }
}

recent-windows {
    highlight {
        active-color "#fff8f5"
        urgent-color "#ba1a1a"
    }
}

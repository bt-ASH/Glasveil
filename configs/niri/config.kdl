// =============================================================================
// Niri 主配置 (结构对齐 ~/Nyxuri/configs/niri)
// =============================================================================
// 引入由 nwg-displays 生成的显示器配置
include "monitor.kdl"
// 机器特有显示器参数 (受 Dunder Protocol 保护，更新自动保留)
include optional=true "monitor__custom__.kdl"
// 动态引入视觉特效样式 (普通模式 effects_normal.kdl / 护眼模式 effects_eyecare.kdl)
include "effects.kdl"
// 引入输入设备与手势配置 (受 Dunder Protocol 保护，更新自动保留)
include optional=true "input__custom__.kdl"
// 引入布局设置
include "layout.kdl"
// 引入焦点环与阴影光晕零件 (default / glow / glow-material-you)
include "glow.kdl"
// 动态焦点光晕（Matugen 渲染的 colors.kdl）仅在 glow 预设切到
// glow-material-you 时由 glow.kdl 内部引入，默认不加载 —— 与 Nyxuri 一致。
// 引入动画配置
include "animations.kdl"
// 引入窗口与图层规则
include "rules.kdl"
// 引入快捷键绑定配置
include "binds.kdl"

overview {
    // Nyxuri 样式：固定半透明底色 + 关闭工作区阴影
    // 不再使用「模糊壁纸 + 独立 awww overview 图层」方案（相关脚本已移除）
    backdrop-color "#4c566a90"
    workspace-shadow {
        off
    }
}

environment {
    ELECTRON_OZONE_PLATFORM_HINT "wayland"
    //LC_MESSAGES "zh_CN.UTF-8"
    XMODIFIERS "@im=fcitx"
}

// =============================================================================
// 开机自启 (命令保持本机原有)
// =============================================================================
// PolKit 认证代理（GUI 密码弹窗）
spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"
spawn-at-startup "nm-applet"
spawn-sh-at-startup "bash ~/.config/eww/scripts/launch.sh"
spawn-sh-at-startup "sh ~/.config/eww/scripts/watch-outputs.sh"
spawn-at-startup "xwayland-satellite"
spawn-at-startup "sh" "-c" "sleep 2 && DISPLAY=:1 glava --desktop"
spawn-at-startup "awww-daemon"
spawn-at-startup "fcitx5 --replace -d"
spawn-at-startup "~/.config/niri/scripts/restore-wallpaper.sh"
// 开机按当前明暗校正 kitty 的 256 色立方体覆盖（light 挂 / dark 摘）
spawn-at-startup "~/.config/scripts/kitty-cube-tune.sh" "auto"
// 电池保护：开机把充电上限锁到 80%（下限 75%）；无 root 权限时静默跳过
spawn-at-startup "~/.config/niri/scripts/battery-care.sh"
spawn-at-startup "~/.config/niri/scripts/swayidle.sh"
// 护眼状态自愈：重启后按 effects.kdl 实际指向重新对齐 wlsunset 色温
spawn-at-startup "~/.config/niri/scripts/toggle-eyecare.sh" "--sync"
spawn-sh-at-startup "clipse --listen"
spawn-sh-at-startup "dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=niri & /usr/lib/xdg-desktop-portal-gnome"

hotkey-overlay {
    // Uncomment this line to disable the "Important Hotkeys" pop-up at startup.
    skip-at-startup
}

prefer-no-csd
//screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// 原有 debug.kdl 内容（N 卡相关，按需取消注释）
// 禁止niri使用N卡（别取消下面这段的注释）
//debug {
//
//    ignore-drm-device "/dev/dri/by-path/pci-0000:01:00.0-card"
//    ignore-drm-device "/dev/dri/by-path/pci-0000:01:00.0-render"
//}
// 下面是 GPU 1: NVIDIA GeForce 940MX [Discrete]
// debug {
//    render-drm-device "/dev/dri/renderD128"
// }

cursor {
    xcursor-theme "mornye-wuwa-cursors"
    xcursor-size 16
    hide-after-inactive-ms 3000
}

recent-windows {
    // off
    debounce-ms 750

    open-delay-ms 150

    highlight {
        active-color "#1e1e2eff"
        urgent-color "#89b4fbff"
        padding 30
        corner-radius 14
    }

    previews {
        max-height 480
        max-scale 0.5
    }

    binds {
        Alt+Tab         { next-window; }
        Alt+Shift+Tab   { previous-window; }
        Alt+grave       { next-window     filter="app-id"; }
        Alt+Shift+grave { previous-window filter="app-id"; }
    }
}

// ==========================================================
// 用户自定义配置 (User Custom Configuration)
// 将自定义的自启项或窗口规则写在 __custom__.kdl 中，更新时自动保留。
// 你也可以在当前目录创建 __custom__/ 文件夹放置个人脚本。
// ==========================================================
include "__custom__.kdl"

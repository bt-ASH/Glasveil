#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Steam 创意工坊壁纸查看器 / Wallpaper Engine workshop browser

默认模式用 rofi 弹出带缩略图的选片菜单（Enter → mpv 全屏循环播放）。
另有浏览器画廊、终端列表、mpv 连续播放。

用法:
    wallpapers                 # 一键：rofi 缩略图选片 → mpv 全屏循环
    wallpapers gallery         # 浏览器里的缩略图画廊（可搜索、点击播放）
    wallpapers list            # 终端里列出全部壁纸
    wallpapers play            # mpv 全屏连播全部
    wallpapers play 蒂法        # 只播标题/标签匹配的
    wallpapers --no-open       # 只生成画廊不打开
    wallpapers --root DIR      # 指定别的收集目录

环境变量:
    WALLPAPER_ROOT   壁纸目录（默认 431960 创意工坊目录）
    WALLPAPER_MPV    mpv 可执行文件/额外参数（默认 "mpv"）
"""

from __future__ import annotations

import argparse
import html
import json
import os
import shutil
import subprocess
import sys
import urllib.parse
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

DEFAULT_ROOT = Path("/home/ash/.local/share/Steam/steamapps/workshop/content/431960")
VIDEO_EXT = {".mp4", ".webm", ".mkv", ".mov", ".m4v", ".avi", ".flv", ".wmv"}
IMAGE_EXT = {".jpg", ".jpeg", ".png", ".gif", ".webp", ".avif", ".bmp"}


def cache_dir() -> Path:
    base = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache")
    d = base / "wallpaper-gallery"
    d.mkdir(parents=True, exist_ok=True)
    return d


def run(cmd: list[str]) -> str:
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=20).stdout.strip()
    except Exception:
        return ""


def probe(path: Path) -> tuple[int, int, float]:
    """返回 (宽, 高, 时长秒)，失败为 0。"""
    if not shutil.which("ffprobe"):
        return 0, 0, 0.0
    out = run([
        "ffprobe", "-v", "error", "-select_streams", "v:0",
        "-show_entries", "stream=width,height:format=duration",
        "-of", "json", str(path),
    ])
    try:
        data = json.loads(out or "{}")
        st = (data.get("streams") or [{}])[0]
        dur = float((data.get("format") or {}).get("duration") or 0)
        return int(st.get("width") or 0), int(st.get("height") or 0), dur
    except Exception:
        return 0, 0, 0.0


def human_size(n: float) -> str:
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1024 or unit == "TB":
            return f"{n:.0f} {unit}" if unit in ("B", "KB") else f"{n:.1f} {unit}"
        n /= 1024.0
    return f"{n:.1f} TB"


def load_probe_cache() -> dict:
    try:
        return json.loads((cache_dir() / "probe-cache.json").read_text(encoding="utf-8"))
    except Exception:
        return {}


def save_probe_cache(cache: dict) -> None:
    try:
        (cache_dir() / "probe-cache.json").write_text(
            json.dumps(cache, ensure_ascii=False), encoding="utf-8")
    except Exception:
        pass


def probe_many(paths: list[Path]) -> dict[str, tuple[int, int, float]]:
    """并发探测，并把结果按 (路径|mtime|大小) 缓存，第二次打开瞬间出结果。"""
    cache = load_probe_cache()
    out: dict[str, tuple[int, int, float]] = {}
    todo: list[tuple[Path, str]] = []
    for p in paths:
        try:
            st = p.stat()
            key = f"{p}|{int(st.st_mtime)}|{st.st_size}"
        except OSError:
            continue
        if key in cache:
            v = cache[key]
            out[str(p)] = (int(v[0]), int(v[1]), float(v[2]))
        else:
            todo.append((p, key))
    if todo:
        with ThreadPoolExecutor(max_workers=min(16, len(todo))) as ex:
            results = list(ex.map(lambda pk: probe(pk[0]), todo))
        for (p, key), r in zip(todo, results):
            out[str(p)] = r
            cache[key] = [r[0], r[1], round(r[2], 3)]
        save_probe_cache(cache)
    return out


def human_dur(sec: float) -> str:
    if sec <= 0:
        return ""
    sec = int(round(sec))
    h, rem = divmod(sec, 3600)
    m, s = divmod(rem, 60)
    return f"{h}:{m:02d}:{s:02d}" if h else f"{m}:{s:02d}"


def pick_file(d: Path, names: list[str]) -> Path | None:
    for n in names:
        if not n:
            continue
        p = d / n
        if p.is_file():
            return p
    return None


def collect(root: Path) -> list[dict]:
    items: list[dict] = []
    if not root.is_dir():
        return items
    for d in sorted(root.iterdir()):
        if not d.is_dir() or d.name.startswith("."):
            continue
        meta: dict = {}
        pj = d / "project.json"
        if pj.is_file():
            try:
                meta = json.loads(pj.read_text(encoding="utf-8", errors="replace"))
            except Exception:
                meta = {}

        media = pick_file(d, [str(meta.get("file") or "")])
        preview = pick_file(d, [str(meta.get("preview") or "")])
        if preview is None:
            cands = sorted(
                [p for p in d.iterdir() if p.is_file() and p.suffix.lower() in IMAGE_EXT],
                key=lambda p: p.stat().st_size, reverse=True,
            )
            preview = cands[0] if cands else None
        if media is None:
            media = pick_file(d, ["scene.json", "scene.pkg"])

        media_ext = media.suffix.lower() if media else ""
        playable = bool(media and media.is_file() and media_ext in (VIDEO_EXT | IMAGE_EXT))
        # 场景类（scene.pkg）无法用 mpv 播放，只能显示预览图
        if str(meta.get("type", "")).lower() == "scene" and media_ext not in (VIDEO_EXT | IMAGE_EXT):
            playable = False

        thumb = preview or media
        try:
            size = sum(p.stat().st_size for p in d.rglob("*") if p.is_file())
        except Exception:
            size = 0

        title = str(meta.get("title") or d.name).replace("\n", " ").strip() or d.name
        tags = meta.get("tags") or []
        if isinstance(tags, str):
            tags = [tags]
        items.append({
            "id": d.name,
            "title": title,
            "type": str(meta.get("type") or ("video" if media_ext in VIDEO_EXT else "file")),
            "tags": [str(t) for t in tags],
            "rating": str(meta.get("contentrating") or ""),
            "dir": str(d),
            "media": str(media) if media and media.is_file() else "",
            "preview": str(thumb) if thumb else "",
            "playable": playable,
            "width": 0, "height": 0, "duration": 0.0,
            "size": size,
        })
    # 分辨率/时长：并发 ffprobe + 缓存
    vids = [Path(it["media"]) for it in items
            if it["media"] and Path(it["media"]).suffix.lower() in VIDEO_EXT]
    if vids:
        infos = probe_many(vids)
        for it in items:
            info = infos.get(it["media"])
            if info:
                it["width"], it["height"], it["duration"] = info
    items.sort(key=lambda i: i["title"].lower())
    return items


def as_url(p: str) -> str:
    return "file://" + urllib.parse.quote(p, safe="/")


TYPE_ZH = {"video": "视频", "scene": "场景", "web": "网页", "application": "程序"}

# rofi 主题：用 wallpicker 那套（深绿渐变底 + 无文字）。
# 但它的网格是「231:816 竖条」专用的（宽度由图片比例决定），这里的预览是整张
# 16:9 截图，所以在 cmd_rofi 里用 -theme-str 覆盖回普通缩略图网格。
ROFI_THEME_FILE = os.path.expanduser("~/.config/rofi/wallpaper.rasi")

# 覆盖回 4×2 网格：格子固定、图标方框为正方形，整张截图都能放下
ROFI_GRID_OVERRIDE = " ".join((
    "window { width: 64%; height: 58%; }",
    "mainbox { padding: 18px 24px; }",
    "listview { columns: 4; lines: 2; spacing: 16px; }",
    "element { border: 2px; }",
    "element-icon { size: 210px; squared: true; }",
))


CSS = """

JS = """
const cards=[...document.querySelectorAll('.card')];
const box=document.getElementById('viewer'),stage=box.querySelector('.stage'),
  bar=box.querySelector('.bar'),q=document.getElementById('q');
let cur=-1;
function show(i){
  if(!cards.length)return;
  i=(i+cards.length)%cards.length;cur=i;
  const c=cards[i];
  stage.innerHTML='';
  if(c.dataset.playable==='1'){
    const v=document.createElement('video');
    v.src=c.dataset.media;v.controls=true;v.autoplay=true;v.loop=true;v.playsInline=true;
    stage.appendChild(v);
  }else if(c.dataset.preview){
    const im=document.createElement('img');im.src=c.dataset.preview;stage.appendChild(im);
  }
  const extra=c.dataset.playable==='1'?'':' · engine scene 包，只能显示预览';
  bar.innerHTML='';
  const t=document.createElement('b');t.textContent=c.dataset.title;
  const m=document.createElement('span');m.textContent=c.dataset.meta+extra;
  const cp=document.createElement('button');cp.textContent='复制路径';
  cp.onclick=()=>{navigator.clipboard.writeText(c.dataset.source||'').then(
    ()=>cp.textContent='已复制',()=>cp.textContent='复制失败');};
  const nx=document.createElement('button');nx.textContent='下一个 →';
  nx.onclick=()=>show(cur+1);
  const cl=document.createElement('button');cl.textContent='关闭 Esc';
  cl.onclick=close;
  bar.append(t,m,cp,nx,cl);
  box.hidden=false;document.body.style.overflow='hidden';
}
function close(){stage.innerHTML='';box.hidden=true;document.body.style.overflow='';cur=-1}
cards.forEach((c,i)=>c.addEventListener('click',()=>show(i)));
box.addEventListener('click',e=>{if(e.target===box||e.target===stage)close()});
addEventListener('keydown',e=>{
  if(e.key==='Escape')close();
  else if(!box.hidden&&e.key==='ArrowRight')show(cur+1);
  else if(!box.hidden&&e.key==='ArrowLeft')show(cur-1);
  else if(e.key==='/'&&document.activeElement!==q){e.preventDefault();q.focus()}
});
function filter(){
  const s=q.value.trim().toLowerCase();let n=0;
  cards.forEach(c=>{
    const hit=!s||(c.dataset.title+' '+c.dataset.tags).toLowerCase().includes(s);
    c.style.display=hit?'':'none';if(hit)n++;
  });
  document.getElementById('count').textContent=n+' / '+cards.length;
}
q.addEventListener('input',filter);filter();
"""


def build_gallery(items: list[dict]) -> Path:
    cdir = cache_dir()
    cards = []
    for it in items:
        tags = " · ".join(it["tags"])
        res = f'{it["width"]}×{it["height"]}' if it["width"] and it["height"] else ""
        dur = human_dur(it["duration"])
        meta = " · ".join(b for b in (tags, res, dur, human_size(it["size"])) if b)
        badge_type = TYPE_ZH.get(it["type"].lower(), it["type"])
        badges = f'<span class="badge b-type">{html.escape(badge_type)}</span>'
        if dur:
            badges += f'<span class="badge b-dur">{dur}</span>'
        if not it["playable"]:
            badges += ('<span class="badge" style="bottom:8px;left:8px;color:#ffd479">仅预览</span>')
        img = (f'<img src="{html.escape(as_url(it["preview"]))}" loading="lazy" alt="">'
               if it["preview"] else "")
        cards.append(
            f'<figure class="card" data-playable="{1 if it["playable"] else 0}" '
            f'data-media="{html.escape(as_url(it["media"]))}" '
            f'data-preview="{html.escape(as_url(it["preview"]))}" '
            f'data-title="{html.escape(it["title"], quote=True)}" '
            f'data-tags="{html.escape(" ".join(it["tags"]), quote=True)}" '
            f'data-meta="{html.escape(meta, quote=True)}" '
            f'data-source="{html.escape(it["media"] or it["preview"], quote=True)}">'
            f'<div class="thumb">{img}{badges}</div>'
            f'<figcaption><b>{html.escape(it["title"])}</b>'
            f'<small>{html.escape(meta or "—")}</small></figcaption>'
            '</figure>'
        )

    page = (
        '<!doctype html>\n<html lang="zh-CN"><head><meta charset="utf-8">\n'
        f'<title>壁纸画廊 · {len(items)}</title>\n'
        '<meta name="viewport" content="width=device-width,initial-scale=1">\n'
        f'<style>{CSS}</style></head><body>\n'
        f'<header><h1>创意工坊壁纸<small><span id="count">{len(items)}</span> 项</small></h1>\n'
        '<input id="q" placeholder="搜索标题 / 标签…" autocomplete="off">\n'
        '<span class="hint">点击卡片播放 · ← → 切换 · Esc 关闭</span></header>\n'
        '<main id="grid">\n' + "\n".join(cards) + '\n</main>\n'
        '<div id="viewer" hidden><div class="stage"></div><div class="bar"></div></div>\n'
        f'<script>{JS}</script>\n</body></html>\n'
    )
    index = cdir / "index.html"
    index.write_text(page, encoding="utf-8")
    (cdir / "manifest.json").write_text(
        json.dumps(items, ensure_ascii=False, indent=1), encoding="utf-8")
    return index


def cmd_list(items: list[dict]) -> None:
    print(f"{'#':>3}  {'类型':<4} {'时长':>8} {'大小':>9}  标题")
    for i, it in enumerate(items, 1):
        t = TYPE_ZH.get(it["type"].lower(), it["type"])[:4]
        print(f"{i:>3}  {t:<4} {human_dur(it['duration']):>8} "
              f"{human_size(it['size']):>9}  {it['title']}")
    total = sum(it["size"] for it in items)
    print(f"\n共 {len(items)} 项，合计 {human_size(total)}")


def mpv_cmd() -> list[str]:
    return (os.environ.get("WALLPAPER_MPV") or "mpv").split()


def play_files(paths: list[Path]) -> int:
    if not paths:
        print("没有可播放的文件", file=sys.stderr)
        return 1
    cmd = mpv_cmd() + ["--fullscreen", "--no-terminal", "--title=壁纸预览"]
    if len(paths) > 1:
        m3u = cache_dir() / "playlist.m3u8"
        m3u.write_text("#EXTM3U\n" + "\n".join(str(p) for p in paths) + "\n",
                       encoding="utf-8")
        cmd += ["--loop-playlist=inf", f"--playlist={m3u}"]
    else:
        cmd += ["--loop-file=inf", str(paths[0])]
    return subprocess.call(cmd)


def play_target(it: dict) -> Path:
    """能播的播正片，engine 场景包退化成预览图。"""
    if it["playable"] and it["media"]:
        return Path(it["media"])
    return Path(it["preview"])


def copy_path(path: str) -> None:
    if shutil.which("wl-copy"):
        subprocess.run(["wl-copy"], input=path, text=True, check=False)
    elif shutil.which("xclip"):
        subprocess.run(["xclip", "-selection", "clipboard"], input=path, text=True, check=False)
    if shutil.which("notify-send"):
        subprocess.run(["notify-send", "-a", "wallpapers", "壁纸路径已复制", path],
                       check=False)


def rofi_rows(pool: list[dict]) -> str:
    """rofi dmenu 输入：每行 `文本\\0icon\\x1f<预览图路径>`。"""
    rows = []
    for it in pool:
        title = it["title"] if len(it["title"]) <= 44 else it["title"][:43] + "…"
        bits = [b for b in (it["tags"][0] if it["tags"] else "", human_dur(it["duration"]),
                            human_size(it["size"])) if b]
        note = "" if it["playable"] else "  ·  仅预览"
        text = f"{title}{note}   ·   {' · '.join(bits)}"
        icon = it["preview"] or ""
        rows.append(f"{text}\0icon\x1f{icon}" if icon else text)
    return "\n".join(rows) + "\n"


def cmd_rofi(items: list[dict]) -> int:
    pool = [it for it in items if it["playable"] or it["preview"]]
    if not pool:
        print("没有可用的壁纸", file=sys.stderr)
        return 1
    gui = os.environ.get("WAYLAND_DISPLAY") or os.environ.get("DISPLAY")
    if not (shutil.which("rofi") and gui):
        return cmd_fallback_pick(pool)

    cmd = [
        "rofi", "-dmenu", "-i", "-show-icons",
        "-format", "i",                       # 只输出选中行号
        "-kb-custom-1", "Ctrl+o",
        "-no-custom",
    ]
    # 有统一主题文件就用它（渐变底 + 大缩略图 + 无文字），再覆盖成网格
    if os.path.isfile(ROFI_THEME_FILE):
        cmd += ["-theme", ROFI_THEME_FILE, "-theme-str", ROFI_GRID_OVERRIDE]
    else:
        cmd += ["-p", "壁纸",
                "-mesg", "Enter 播放 · Ctrl+O 复制路径 · Esc 取消",
                "-theme-str", "window {width: 62%;} listview {columns: 3; lines: 4; spacing: 14px;}"]
    p = subprocess.run(cmd, input=rofi_rows(pool), text=True, capture_output=True)
    if p.returncode not in (0, 10) or not p.stdout.strip().isdigit():
        return 0                              # 用户取消
    idx = int(p.stdout.strip())
    if not (0 <= idx < len(pool)):
        return 0
    it = pool[idx]
    if p.returncode == 10:                    # Ctrl+O：复制路径
        copy_path(it["media"] or it["preview"])
        return 0
    return play_files([play_target(it)])


def cmd_fallback_pick(pool: list[dict]) -> int:
    """没有 rofi/图形会话时的退路：fzf 或编号输入。"""
    labels = [f"{it['title']}   ·   "
              f"{human_dur(it['duration']) or TYPE_ZH.get(it['type'].lower(), it['type'])}"
              for it in pool]
    idx = None
    if shutil.which("fzf"):
        p = subprocess.run(["fzf", "-d", "\t", "--with-nth=2.."],
                           input="\n".join(f"{i}\t{l}" for i, l in enumerate(labels)),
                           text=True, capture_output=True)
        if p.returncode == 0 and p.stdout.strip():
            idx = int(p.stdout.split("\t")[0])
    else:
        for i, l in enumerate(labels, 1):
            print(f"{i:>2}. {l}")
        try:
            idx = int(input("选择编号: ")) - 1
        except Exception:
            return 1
    if idx is None or not (0 <= idx < len(pool)):
        return 0
    return play_files([play_target(pool[idx])])


def cmd_play(items: list[dict], keyword: str | None) -> int:
    pool = [it for it in items if it["playable"]]
    if keyword:
        k = keyword.lower()
        pool = [it for it in pool if k in (it["title"] + " " + " ".join(it["tags"])).lower()]
    return play_files([Path(it["media"]) for it in pool])


def main() -> int:
    ap = argparse.ArgumentParser(
        prog="wallpapers",
        description="浏览 Steam 创意工坊壁纸（Wallpaper Engine appid 431960）")
    ap.add_argument("mode", nargs="?", default="rofi",
                    choices=["rofi", "gallery", "list", "play", "pick"],
                    help="默认 rofi（pick 为 rofi 的旧别名）")
    ap.add_argument("keyword", nargs="?", help="play 时用于过滤标题/标签")
    ap.add_argument("--root", help="壁纸目录")
    ap.add_argument("--no-open", action="store_true", help="只生成画廊，不打开浏览器")
    a = ap.parse_args()

    root = Path(a.root).expanduser() if a.root else Path(
        os.environ.get("WALLPAPER_ROOT") or DEFAULT_ROOT).expanduser()
    items = collect(root)
    if not items:
        print(f"没找到壁纸：{root}", file=sys.stderr)
        return 1

    if a.mode == "list":
        cmd_list(items)
        return 0
    if a.mode == "play":
        return cmd_play(items, a.keyword)
    if a.mode in ("rofi", "pick"):
        return cmd_rofi(items)

    index = build_gallery(items)
    if a.no_open:
        print(index)
        return 0
    opener = (shutil.which("chromium") or shutil.which("google-chrome-stable")
              or shutil.which("google-chrome") or shutil.which("xdg-open"))
    if not opener:
        print(f"画廊已生成：{index}", file=sys.stderr)
        return 1
    cmd = [opener, "--new-window", str(index)] if "chrom" in opener else [opener, str(index)]
    subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)
    print(index)
    return 0


if __name__ == "__main__":
    sys.exit(main())

/**
 * Glasveil · rofi 电源菜单 / rofi power menu
 * ---------------------------------------------------------------------------
 * 启动：configs/niri/scripts/powermenu（niri 键位：Mod+X）
 *       └─ rofi -dmenu → 锁屏 / 关屏 / 退出 / 挂起 / 重启 / 关机
 *
 * 配色同样来自 matugen 渲染的 colors.rasi（模板 see configs/matugen）。
 * 两行四列的卡片布局，纯文字条目 + Nerd Font 图标。
 */

@import "./colors.rasi"

* {
    font:             "JetBrainsMono Nerd Font 11";
    background-color: transparent;
    text-color:       @text;
}

configuration {
    scroll-method: 1;
    show-icons:    false;
}

/*****----- 窗口 / Window -----*****/
window {
    transparency:     "real";
    location:         center;
    anchor:           center;
    width:            450px;
    padding:          8px;
    border:           1px solid;
    border-color:     @outline;
    border-radius:    18px;
    background-color: @bg;
}

mainbox {
    spacing:      6px;
    children:     [ "header", "listview", "footer" ];
}

/*****----- 标题栏 / Header -----*****/
header {
    expand:           false;
    orientation:      horizontal;
    background-color: @bg-alt;
    border-radius:    12px;
    children:         [ "textbox-tag", "textbox-title" ];
}
textbox-tag {
    str:              "";
    expand:           false;
    padding:          6px 10px;
    border-radius:    12px 0px 0px 12px;
    background-color: @primary;
    text-color:       @on-primary;
}
textbox-title {
    str:            "POWER // 电源菜单";
    padding:        6px 12px;
    vertical-align: 0.5;
    text-color:     @primary;
}

/*****----- 菜单 / Listview -----*****/
listview {
    lines:            4;
    columns:          3;
    layout:           horizontal;
    spacing:          4px;
    padding:          0px;
    border:           0px;
    cycle:            true;
    fixed-height:     true;
    fixed-columns:    true;
    scrollbar:        false;
    background-color: transparent;
}

element {
    padding:          11px 6px;
    border:           0px 0px 0px 3px;
    border-radius:    10px;
    border-color:     transparent;
    background-color: transparent;
    text-color:       @text;
}
element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color:       @text;
}
element selected.normal {
    background-color: @secondary-container;
    text-color:       @on-secondary-container;
    border-color:     @primary;
}
element-text {
    background-color:  transparent;
    text-color:        inherit;
    vertical-align:    0.5;
    horizontal-align:  0.5;
}

/*****----- 底部提示 / Footer -----*****/
footer {
    expand:           false;
    orientation:      horizontal;
    padding:          4px 10px 2px 10px;
    children:         [ "textbox-hint" ];
}
textbox-hint {
    str:              "[Enter] 执行    [Esc] 关闭";
    expand:           true;
    horizontal-align: 0.5;
    text-color:       @muted;
}

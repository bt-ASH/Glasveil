/* 壁纸选择器（rofi 缩略图网格）—— 对齐 waypaper 的观感：
 * 3 列大缩略图、无文字、浅色半透明卡片、选中项蓝色圆角描边 */
* {
    bg:    rgba(250, 248, 255, 0.92);
    acc:   #7aa2f7;
    clear: rgba(0, 0, 0, 0);
}

window {
    width:            78%;
    height:           80%;
    background-color: @bg;
    border-radius:    20px;
    padding:          18px;
}

/* 只留网格，隐藏顶部输入条（想恢复过滤功能就删掉下面这行 children） */
mainbox {
    children: [ listview ];
    padding:  0px;
    spacing:  0px;
}

listview {
    columns:       3;
    lines:         4;
    fixed-columns: true;
    spacing:       18px;
    padding:       0px;
    border:        0px;
    scrollbar:     false;
}

element {
    padding:          6px;
    spacing:          0px;
    border:           2px;
    border-radius:    16px;
    border-color:     @clear;
    background-color: @clear;
}

element normal.normal   { background-color: @clear; }
element selected.normal { border-color: @acc; background-color: @clear; }

element-icon {
    size:   20em;
    cursor: pointer;
}

/* 缩略图网格不显示文字标签 */
element-text {
    enabled: false;
}

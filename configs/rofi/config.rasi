/**
 * Glasveil · rofi 应用启动器 / rofi application launcher
 * ---------------------------------------------------------------------------
 * 面向 niri（Wayland layer-shell）适配：
 *   · 配色不写死：@import colors.rasi，由 matugen 从壁纸渲染
 *     （模板 configs/matugen/templates/rofi-colors.rasi）
 *   · 字体 / 图标主题跟随本机（JetBrainsMono Nerd Font + Papirus-Dark）
 *   · 圆角 + 半透明窗口，与 eww 胶囊状态栏同一套 Material You 语言
 *
 * 用法：rofi -show drun            （niri 键位：Mod+Shift+W）
 *
 * 注意：rofi 对 *{} 里 rgba() 变量用在 element 背景上会回退成白色，
 *       所以 colors.rasi 全部使用 8 位十六进制（#RRGGBBAA）。
 */

configuration {
    modi:                "drun";
    display-drun:        "";
    drun-display-format: "{name}";
    show-icons:          true;
    icon-theme:          "Papirus-Dark";
    font:                "JetBrainsMono Nerd Font 11";
    matching:            "fuzzy";
    sorting-method:      "fzf";
    cycle:               true;
    hover-select:        true;
    click-to-exit:       true;
}

@import "./colors.rasi"

/*****----- 窗口 / Window -----*****/
window {
    transparency:     "real";
    location:         center;
    anchor:           center;
    width:            560px;
    padding:          8px;
    border:           1px solid;
    border-color:     @outline;
    border-radius:    18px;
    background-color: @bg;
    cursor:           "default";
}

/*****----- 主容器 / Main box -----*****/
mainbox {
    spacing:          6px;
    padding:          0px;
    border:           0px;
    background-color: transparent;
    children:         [ "inputbar", "listview" ];
}

/*****----- 搜索栏 / Input bar -----*****/
inputbar {
    spacing:          10px;
    padding:          14px 16px;
    border:           0px;
    border-radius:    12px;
    background-color: @surface;
    text-color:       @text;
    children:         [ "prompt", "entry" ];
}

prompt {
    font:             "JetBrainsMono Nerd Font 13";
    padding:          0px 4px 0px 0px;
    background-color: inherit;
    text-color:       @primary;
}

entry {
    background-color:  inherit;
    text-color:        @text;
    placeholder:       "搜索应用…";
    placeholder-color: @muted;
    cursor:            "text";
}

/*****----- 列表 / Listview -----*****/
listview {
    lines:            8;
    columns:          1;
    spacing:          4px;
    padding:          4px 0px 0px 0px;
    border:           0px;
    cycle:            true;
    layout:           vertical;
    reverse:          false;
    fixed-height:     true;
    fixed-columns:    true;
    scrollbar:        false;
    background-color: transparent;
    text-color:       @text;
}

/*****----- 条目 / Elements -----*****/
element {
    spacing:          12px;
    padding:          10px 12px;
    border:           0px;
    border-radius:    12px;
    background-color: transparent;
    text-color:       @text;
    cursor:           "pointer";
}
element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color:       @text;
}
element selected.normal {
    background-color: @secondary-container;
    text-color:       @on-secondary-container;
}

element-icon {
    size:             26px;
    background-color: transparent;
}
element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
    horizontal-align: 0.0;
}

/*****----- 出错提示 / Error message -----*****/
error-message {
    padding:          12px;
    border:           1px solid;
    border-radius:    12px;
    border-color:     @error;
    background-color: @bg;
    text-color:       @error;
}

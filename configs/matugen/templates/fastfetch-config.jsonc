// 来源 https://github.com/Emii-lia/cachy-gnome-dotfiles/tree/master/config/neofetch

{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "~/.config/fastfetch/images/shenhe.png",
    "width": 32,
    "height": 14,
    "padding": {
      "width": 28,
      "height": 14,
      "top": 1,
      "left": 2,
      "right": 3
    },
    "printRemaining": true,
    "preserveAspectRatio": true,
    "position": "left"
  },
  "display": {
    "separator": ": ",
    "color": {
      "keys": "",
      "title": "",
      "output": "",
      "separator": ""
    },
    "brightColor": true,
    "duration": {
      "abbreviation": true,
      "spaceBeforeUnit": "default"
    },
    "size": {
      "binaryPrefix": "iec",
      "ndigits": 2,
      "spaceBeforeUnit": "default"
    },
    "bar": {
      "char": {
        "elapsed": "-",
        "total": "="
      },
      "border": {
        "left": "[",
        "right": "]"
      },
      "color": {},
      "width": 15
    },
    "percent": {
      "type": [
        "num",
        "num-color"
      ]
    },
    "key": {
      "width": 0,
      "type": "string"
    }
  },
  "general": {
    "playerName": "auto"
  },
  "modules": [
    "break",
    {
      "type": "title",
      "fqdn": false
    },
    {
      "type": "separator",
      "string": "-"
    },
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    {
      "type": "display",
      "preciseRefreshRate": true
    },
    "de",
    "wm",
    "wmtheme",
    "theme",
    "terminal",
    {
      "type": "cpu",
      "temp": false
    },
    {
      "type": "gpu",
      "hideType": "none",
      "temp": false
    },
    {
      "type": "memory",
      "keyIcon": "",
      "percent": {
        "type": 0
      }
    },
    "media",
    "player",
    "break",
    "colors"
  ]
}

